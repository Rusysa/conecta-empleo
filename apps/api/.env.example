PORT=3001
NODE_ENV=development
# Supabase local; para remoto usar la conexión PostgreSQL/pooler con SSL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Para Supabase remoto, desde apps/api (dejar vacío para la base local):
DATABASE_SSL_CA_FILE=
# DATABASE_SSL_CA_FILE=../../database/certs/supabase-ca.crt
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
APP_ORIGINS=http://localhost:3000,http://localhost:5173
